# Config fragment: external USB Wi-Fi (monitor mode / injection) for Redmi Note 9S (curtana)
#
# Usage:  make ARCH=arm64 LawRun_defconfig nethunter.config
#
# Everything is built in (=y) so it works without installing .ko files on a
# MIUI device with read-only system/vendor partitions.

# --- mac80211 / cfg80211 (needed by every driver below; gives monitor mode) ---
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y
CONFIG_MAC80211_RC_MINSTREL=y
CONFIG_MAC80211_RC_MINSTREL_HT=y
CONFIG_MAC80211_RC_DEFAULT_MINSTREL=y
CONFIG_CFG80211_WEXT=y
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_RFKILL=y

# --- Atheros: AR9271 (TP-Link TL-WN722N v1), AR7010, AR9170 ---
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH_COMMON=y
CONFIG_ATH9K_HW=y
CONFIG_ATH9K_COMMON=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y

# --- Ralink / MediaTek: RT2070/RT3070/RT3572/RT5370/RT5372/RT5572, RT2500/RT73 ---
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800USB=y
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RT2500USB=y
CONFIG_RT73USB=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=y

# --- Realtek: RTL8187 (Alfa AWUS036H), RTL8188/8192 CU/EU (rtl8xxxu), RTL8812AU/8821AU/8814AU ---
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8187=y
CONFIG_RTL8XXXU=y
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_88XXAU=y

# --- Firmware for the adapters above, linked into the kernel image ---
# (Android's ueventd can't load firmware for USB devices from /lib/firmware,
#  so embed it.  The CI workflow downloads these into firmware/.)
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="ath9k_htc/htc_9271-1.4.0.fw ath9k_htc/htc_7010-1.4.0.fw rt2870.bin rt73.bin mt7601u.bin carl9170-1.fw rtlwifi/rtl8192cufw_A.bin rtlwifi/rtl8192cufw_B.bin rtlwifi/rtl8192cufw_TMSC.bin rtlwifi/rtl8192eu_nic.bin rtlwifi/rtl8723aufw_A.bin rtlwifi/rtl8723aufw_B.bin rtlwifi/rtl8723aufw_B_NoBT.bin rtlwifi/rtl8723bu_nic.bin rtlwifi/rtl8723bu_bt.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# --- Allow loading extra (e.g. newer out-of-tree) modules ---
# MODULE_SIG_FORCE is dropped so insmod of unsigned modules keeps working.
# CONFIG_MODULE_SIG_FORCE is not set

# --- NetHunter chroot niceties ---
CONFIG_SYSVIPC=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_F_HID=y

# --- KernelSU is not bundled in this repo (KernelSU/ is a dangling symlink to
# the original author's home dir).  Root is expected to come from Magisk. ---
# (CONFIG_KSU is therefore left undefined; the Kconfig source line and obj-y entry were removed.)
